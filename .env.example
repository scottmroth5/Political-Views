# Copy to .env and adjust. Never commit real secrets.

# Local Postgres from docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://political_views:local_dev_password@localhost:5433/political_views?schema=public"

# Used by `npm run test:integration`. Must point at a disposable database.
TEST_DATABASE_URL="postgresql://political_views:local_dev_password@localhost:5433/political_views_test?schema=public"

# Anonymous session lifetime in days (fixed from creation).
SESSION_TTL_DAYS=30

# When true, only questions with editorialStatus=REVIEWED are served.
# Seeded questions are DRAFT until a human editor reviews them; set true before beta.
REQUIRE_REVIEWED_QUESTIONS=false

# Milestone 3 (not yet implemented): AI provider selection.
# AI_PROVIDER=
# AI_API_KEY=
