# /opt/political-views/.env on the server (root:deploy, mode 640). setup-server.sh creates it from
# this file and generates both database passwords. Never commit the real file.

SITE_ADDRESS=views.scottmroth.com

# Generated by setup-server.sh (hex, URL-safe). Don't change after the database exists.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

SESSION_TTL_DAYS=30
# Serve only editorially reviewed questions (launch gate).
REQUIRE_REVIEWED_QUESTIONS=true

# Nightly encrypted backups (backup.sh). AGE_RECIPIENT is the PUBLIC key (age1...) from
# `age-keygen` on your PC; the private key stays in your password manager, never on the server.
AGE_RECIPIENT=
BACKUP_BUCKET=
BACKUP_REGION=us-east-2
# A Lightsail bucket access key with access to that bucket only.
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=30

# Optional usage counts (docs/deployment-plan.md, PostHog). Empty sends nothing.
# The project token (phc_...) is public by design; never put a personal API key (phx_...) here.
ANALYTICS_TOKEN=
ANALYTICS_HOST=https://us.i.posthog.com
